# ============================================
# TrimedCast — Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ---- Database ----
# SQLite (default for local/Docker)
DATABASE_URL=file:./db/trimedcast.db

# PostgreSQL (for production deployment)
# DATABASE_URL=postgresql://trimedcast:changeme@localhost:5432/trimedcast

# ---- Authentication ----
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=trimedcast-secret-change-me-in-production

# Public URL of your deployment
NEXTAUTH_URL=http://localhost:3000
