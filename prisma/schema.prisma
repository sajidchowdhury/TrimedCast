// ============================================
// TrimedCast LEAN Schema — SaaS auth + client's 6 requirements
// (a) Excel upload  (b) session forecast  (c) order qty
// (d) order timing  (e) air vs sea        (f) line cost
// + User auth (email + phone + business name + password)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- User (signup with email + phone + business name + password) ---
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  businessName String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
}

// --- Session (HTTP-only cookie-based auth) ---
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// --- Product Catalog (from client's Excel: Pic No + Item) ---
model Product {
  id           String   @id @default(cuid())
  skuCode      String   @unique // "Pic No" column
  productName  String            // "Item" column
  colorDetails String?           // "Color & Details" column
  category     String? @default("General")
  unitCostBdt  Float?            // optional, can be added later
  sellingPrice Float?            // optional
  hsCode       String? @default("8512") // electrical lighting/signalling
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales        Sale[]
  purchases    Purchase[]
  inventory    Inventory?
  forecastRecs RecommendedOrder[]
}

// --- Sales History (long format: one row per SKU-month) ---
// Melted from the client's wide Excel (Jan..Dec columns).
model Sale {
  id        String   @id @default(cuid())
  skuCode   String
  saleDate  DateTime            // 1st of the month, derived from the column header
  qtySold   Int                 // monthly sales figure
  year      Int
  month     Int                 // 1-12
  createdAt DateTime @default(now())

  product   Product? @relation(fields: [skuCode], references: [skuCode])

  @@index([skuCode, saleDate])
  @@index([year, month])
}

// --- Purchase History (from client's Excel: Order QTY + dates + Send By) ---
model Purchase {
  id                  String   @id @default(cuid())
  skuCode             String
  orderQty            Int               // "Order QTY"
  orderedOn           DateTime          // "Ordered On"
  sendOn              DateTime?         // "Send on"
  receivedOn          DateTime?         // "Received On"
  shipmentMode        String  @default("sea") // "Send By Sea / Air"
  actualLeadTimeDays  Int?              // computed: receivedOn - orderedOn
  createdAt           DateTime @default(now())

  product             Product? @relation(fields: [skuCode], references: [skuCode])

  @@index([skuCode])
  @@index([orderedOn])
}

// --- Current Inventory (starting stock for order-trigger algorithm) ---
model Inventory {
  id         String   @id @default(cuid())
  skuCode    String   @unique
  qtyOnHand  Int      @default(0)
  updatedAt  DateTime @updatedAt

  product    Product? @relation(fields: [skuCode], references: [skuCode])
}

// --- Festival / Session Calendar (Eid, Puja, Summer, Winter, CNY) ---
model FestivalSession {
  id                 String   @id @default(cuid())
  name               String            // e.g. "Durga Puja 2026"
  type               String            // "religious" | "climatic" | "supply"
  peakDate           DateTime
  windowStart        DateTime
  windowEnd          DateTime
  demandEffect       Float             // multiplier: 1.10 = +10% lift, 0.70 = -30% drop
  year               Int
  createdAt          DateTime @default(now())

  @@index([year])
  @@index([peakDate])
}

// --- Forecast Settings (single global config for the lean build) ---
model ForecastSetting {
  id                      String   @id @default(cuid())
  // Lead-time decomposition (BD -> China import lane)
  manufacturingLeadDays   Int      @default(90)
  shipmentSeaDays         Int      @default(52)
  shipmentAirDays         Int      @default(8)
  customsSeaDays          Int      @default(10)
  customsAirDays          Int      @default(3)
  internalProcessingDays  Int      @default(3)
  // EOQ / safety stock defaults
  orderingCostPerOrder    Float    @default(500)   // BDT per PO
  holdingCostPct          Float    @default(0.20)   // 20% of unit cost / yr
  serviceLevel            Float    @default(0.95)   // -> k=1.65
  reviewPeriodDays        Int      @default(10)
  bufferDays              Int      @default(7)
  // CNY window
  cnyStart                String   @default("2027-01-20")
  cnyEnd                  String   @default("2027-02-20")
  // Weekend info (editable — varies per client's suppliers)
  chinaWorkingDays        String   @default("Mon-Sat")
  chinaOffDay             String   @default("Sunday")
  bdWorkingDays           String   @default("Sun-Thu")
  bdOffDays               String   @default("Friday + Saturday")
  weeklyAdminDelayDays    Int      @default(2)
  // Importer recommendations (JSON array of strings)
  recommendationsJson     String   @default("[]")
  updatedAt               DateTime @updatedAt
}

// --- Shipping calendar holidays (editable per client) ---
model Holiday {
  id            String   @id @default(cuid())
  name          String
  country       String   @default("china") // china | bangladesh
  type          String   @default("factory_shutdown") // factory_shutdown | customs_closure | port_closure | bank_holiday
  startISO      String   // yyyy-mm-dd
  endISO        String   // yyyy-mm-dd
  durationDays  Int
  impact        String   @default("")
  affects       String   @default("manufacturing") // manufacturing | shipment | customs | all
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([country])
  @@index([startISO])
}

// --- Forecast results (Phase 2) — per-SKU per-session demand forecast ---
model Forecast {
  id                String   @id @default(cuid())
  skuCode           String
  festivalSessionId String?          // which session this forecast was generated for
  productName       String           // snapshot of product name at generation time
  // Monthly forecast points (JSON array of {date, month, year, predicted, lowerBound, upperBound, festivalName, festivalEffect})
  pointsJson        String           // JSON-serialized ForecastPoint[]
  // Accuracy metrics
  mape              Float   @default(0)
  mae               Float   @default(0)
  rmse              Float   @default(0)
  mse               Float   @default(0)
  bias              Float   @default(0)
  accuracyRating    String  @default("unusable") // excellent|good|fair|poor|unusable
  n                 Int     @default(0)
  // Sum of predicted qty across the horizon (the headline number for "how much to order")
  totalForecastQty  Int     @default(0)
  model             String  @default("prophet-ts-lean")
  historyPoints     Int     @default(0)
  horizonMonths     Int     @default(6)
  generatedAt       DateTime @default(now())

  @@index([skuCode])
  @@index([festivalSessionId])
  @@index([skuCode, festivalSessionId])
}

// --- Recommended Orders (the core output: qty + trigger date + freight mode + landed cost) ---
model RecommendedOrder {
  id                String   @id @default(cuid())
  skuCode           String
  festivalSessionId String?
  // Forecast
  forecastQty       Int?             // per-session forecast units
  mape              Float?           // accuracy metric
  // Order quantity (EOQ + safety stock)
  recommendedQty   Int              // how much to order
  safetyStock       Int
  reorderPoint      Int
  // Order timing
  orderTriggerDate  DateTime?        // WHEN to place the PO
  expectedDelivery  DateTime?        // arrives at warehouse
  urgency           String  @default("normal") // critical|high|normal|low
  // Freight decision (air vs sea)
  recommendedMode   String  @default("sea") // "sea" | "air"
  cnyStrategy       String?           // before_cny|after_cny|partial_order|air_escape
  // Line cost (landed cost per unit)
  landedCostSea     Float?           // BDT per unit, sea
  landedCostAir     Float?           // BDT per unit, air
  marginSea         Float?           // %
  marginAir         Float?           // %
  createdAt         DateTime @default(now())

  product           Product? @relation(fields: [skuCode], references: [skuCode])

  @@index([skuCode])
  @@index([festivalSessionId])
}

// --- Data Import Log (track uploaded Excel files) ---
model DataImport {
  id           String   @id @default(cuid())
  fileName     String
  fileType     String   @default("xlsx")
  fileSize     Int
  importType   String   @default("sales_wide") // the client's wide format
  status       String   @default("pending") // pending|parsed|validated|completed|superseded|failed
  dataYear     Int?     // which year this import's sales belong to (each year = 1 upload)
  rowCount     Int      @default(0)
  skuCount     Int      @default(0)
  saleCount    Int      @default(0)
  purchaseCount Int     @default(0)
  errorCount   Int      @default(0)
  warnings     String?  // JSON string of warnings
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([dataYear])
  @@index([status])
}
